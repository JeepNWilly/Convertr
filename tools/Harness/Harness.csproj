    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Convertr.Harness</AssemblyName>
    <RootNamespace>Convertr.Harness</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Convertr\Convertr.csproj" />
    <ProjectReference Include="..\..\src\Convertr.Core\Convertr.Core.csproj" />
  </ItemGroup>
</Project>
