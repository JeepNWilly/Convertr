<Project>
  <PropertyGroup>
    <ConvertrVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</ConvertrVersion>
    <ConvertrBuild>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)BUILD_NUMBER').Trim())</ConvertrBuild>
    <Version>$(ConvertrVersion)</Version>
    <AssemblyVersion>$(ConvertrVersion).$(ConvertrBuild)</AssemblyVersion>
    <FileVersion>$(ConvertrVersion).$(ConvertrBuild)</FileVersion>
    <InformationalVersion>$(ConvertrVersion) (build $(ConvertrBuild))</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>JeepNWilly</Authors>
    <Company>JeepNWilly</Company>
    <Copyright>Copyright (C) 2026 JeepNWilly</Copyright>
    <Product>Convertr</Product>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
